# OpenSEO VPS self-host env. Copy to deploy/.env ON THE VPS ONLY.
# deploy/.env is gitignored (repo .gitignore ignores .env and .env.*) — the
# fork is PUBLIC, so a key committed here is a key leaked.

# ---------- Required for SEO data ----------
# base64 of "your-dataforseo-login:your-dataforseo-API-password".
# NOT the key shown on the DataForSEO dashboard. See docs/DATAFORSEO_API_KEY.md.
#   printf '%s' 'login:password' | base64
# Without it the app still boots; every SEO feature is unavailable.
DATAFORSEO_API_KEY=

# ---------- Serving ----------
# Must match the hostname cloudflared forwards, or vite preview rejects the
# Host header and every request 403s.
ALLOWED_HOST=seo.momentumcag.com
PORT=3001

# ---------- Telemetry ----------
# Upstream sends an anonymous usage heartbeat by default. Off here.
OPENSEO_TELEMETRY_DISABLED=1
DO_NOT_TRACK=1

# ---------- Optional: SAM, the in-app SEO agent ----------
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=

# ---------- Optional: Google Search Console (all three together) ----------
# See docs/SELF_HOSTING_GOOGLE_SEARCH_CONSOLE.md
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# BETTER_AUTH_SECRET=
